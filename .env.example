# Next.js
NEXT_PUBLIC_SITE_URL=https://demo2.raufmedia.com

# CRM session auth (set a real random secret in production)
CRM_AUTH_SECRET=

# Email automation — Resend (get a key at https://resend.com/api-keys)
RESEND_API_KEY=
EMAIL_TO=
EMAIL_FROM="Duvo Demo <onboarding@resend.dev>"
MEET_LINK=https://meet.google.com/new

# Optional: Gmail SMTP instead of Resend (lets emails go to customers directly,
# not just EMAIL_TO — requires 2-Step Verification + an App Password on the account)
GMAIL_USER=
GMAIL_APP_PASSWORD=
